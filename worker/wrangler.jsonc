{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hydra-edge-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "790d2286535b4d96acd02aea9728e0a4",
      
      // Optional: preview_id used when running `wrangler dev` for local dev
      "preview_id": "<ID_OF_PREVIEW_KV_NAMESPACE_FOR_LOCAL_DEVELOPMENT>"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://your-project.supabase.co",
    "ENABLE_IP_BINDING": "true"
  }
}
